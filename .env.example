# CBID Institute LMS (CBID Network PK Sindh) — environment template. Copy to backend/.env for local development
# (and to .env next to docker-compose.yml for Docker). Placeholders only: never commit real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# API connection: MUST be the non-owner role so Row-Level Security applies.
DATABASE_URL=postgres://cbid_app:CHANGE_ME_APP_PASSWORD@localhost:5432/cbid_lms
# Owner connection: migrations, seed and background worker only.
DATABASE_OWNER_URL=postgres://cbid_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/cbid_lms
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# Optional. When set, rate limits are shared across API instances.
REDIS_URL=redis://localhost:6379

# Browser origin of the frontend. Must match exactly (Origin checks + CORS + email links).
APP_ORIGIN=http://localhost:5173
# Set true behind a reverse proxy that sets X-Forwarded-For (needed for per-IP rate limits).
TRUST_PROXY=false
# true in production (HTTPS only). Uses the __Host- cookie prefix when true.
COOKIE_SECURE=false

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
RECOVERY_RATE_LIMIT=5
PASSWORD_RESET_MINUTES=30
INVITE_HOURS=72

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# SMTP is required in production, e.g. smtps://user:password@smtp.example.org:465
# Send from a cbidnetwork.org address only after SPF/DKIM for that domain authorise your SMTP provider.
SMTP_URL=
MAIL_FROM=CBID Institute <no-reply@cbidnetwork.org>

RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_AUDIT_DAYS=730
RETENTION_EMAIL_DAYS=30

# Production single-origin deployment: serve the built frontend from the API.
# SERVE_STATIC_DIR=../frontend/dist

# Development seed only (npm run seed). Never used in production.
SEED_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# Docker Compose only
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
CBID_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
CBID_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
